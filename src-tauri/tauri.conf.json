{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OPUS",
  "version": "2.4.9",
  "identifier": "com.psdesign.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OPUS",
        "width": 1360,
        "height": 820,
        "minWidth": 1300,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/pdfium/pdfium.dll",
      "resources/opus-project.ico",
      "scripts/install-ai-models.ps1"
    ],
    "fileAssociations": [
      {
        "ext": [
          "opus"
        ],
        "name": "OPUS Project",
        "description": "OPUS project file",
        "role": "Editor",
        "mimeType": "application/x-opus-project"
      }
    ],
    "windows": {
      "wix": {
        "fragmentPaths": [
          "wix/opus-project-file-icon.wxs"
        ],
        "componentRefs": [
          "OpusProjectFileIconRegistry"
        ]
      },
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/noguchi-kosei-del/PsDesign/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NzJDOUE1QTNBNENDQUQKUldTdHpLU2pwY2x5UkcwL3ZzeURiWTNrOW40MjFwOHpwUlR4cnpOSFp1OXROS0ZCYktoY3plSUgK"
    }
  }
}
