{
  "name": "opus",
  "private": true,
  "version": "2.4.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run check:encoding && npm run check:security && npm run lint && npm run build",
    "check:encoding": "node scripts/check-source-integrity.mjs",
    "check:security": "node scripts/check-security-regression.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "lint": "eslint src/**/*.js scripts/**/*.mjs vite.config.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync('public/pdfjs',{recursive:true});fs.copyFileSync(p.join('node_modules/pdfjs-dist/build/pdf.worker.min.mjs'),'public/pdfjs/pdf.worker.min.mjs')\""
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "ag-psd": "^25.0.0",
    "pdfjs-dist": "^4.8.69"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "eslint": "^10.4.0",
    "vite": "^5.4.0"
  }
}
